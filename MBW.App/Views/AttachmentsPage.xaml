<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MBW.App.Views.AttachmentsPage"
    x:Name="AttachmentsRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MBW.App.ViewModels"
    xmlns:conv="using:MBW.App.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="X" Modifiers="Control" Invoked="ExplorerCut_Invoked" />
        <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="ExplorerCopy_Invoked" />
        <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="ExplorerPaste_Invoked" />
        <KeyboardAccelerator Key="F2" Invoked="ExplorerRename_Invoked" />
        <KeyboardAccelerator Key="Delete" Invoked="ExplorerDelete_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <conv:AttachmentTypeBrushConverter x:Key="AttachmentTypeBrushConverter" />
        <Style x:Key="ExplorerNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="ExplorerToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource ExplorerNavButtonStyle}" />
        <Style x:Key="SortHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource ExplorerSortHeaderButtonStyle}" />
    </Page.Resources>

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Attachments" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Manage attachment folders and files. The shared folder applies to all recipients; individual folders hold per-recipient attachments."
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,12" Spacing="10" Visibility="{Binding ContentVisibility}">
            <Border Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondary}"
                    BorderBrush="{ThemeResource CardStrokeColorDefault}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding NoWorkspaceVisibility}">
                <TextBlock Text="Create or open a workspace first."
                           TextWrapping="Wrap"
                           Opacity="0.85" />
            </Border>

            <Grid ColumnDefinitions="Auto,*,280" ColumnSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Style="{StaticResource ExplorerNavButtonStyle}"
                            Command="{Binding NavigateBackCommand}"
                            ToolTipService.ToolTip="Back">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource ExplorerNavButtonStyle}"
                            Command="{Binding NavigateForwardCommand}"
                            ToolTipService.ToolTip="Forward">
                        <FontIcon Glyph="&#xE72A;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource ExplorerNavButtonStyle}"
                            Command="{Binding NavigateUpCommand}"
                            ToolTipService.ToolTip="Up">
                        <FontIcon Glyph="&#xE74B;" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource ExplorerNavButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            ToolTipService.ToolTip="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorSecondary}"
                        BorderBrush="{ThemeResource CardStrokeColorDefault}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,4"
                        MinHeight="32"
                        VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding BreadcrumbSegments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BreadcrumbSegmentViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <HyperlinkButton Content="{x:Bind Label}"
                                                     Command="{x:Bind NavigateCommand}"
                                                     Visibility="{x:Bind LinkVisibility}" />
                                    <TextBlock Text="{x:Bind Label}"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Visibility="{x:Bind LabelVisibility}" />
                                    <TextBlock Text="›"
                                               VerticalAlignment="Center"
                                               Opacity="0.5"
                                               FontSize="12"
                                               Margin="0,0,4,0"
                                               Visibility="{x:Bind ChevronVisibility}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <AutoSuggestBox Grid.Column="2"
                                PlaceholderText="{Binding SearchPlaceholder}"
                                Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                QueryIcon="Find"
                                VerticalAlignment="Center" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Command="{Binding CreateFolderCommand}"
                        Visibility="{Binding CreateFolderVisibility}"
                                ToolTipService.ToolTip="New folder">
                    <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                </Button>
                <Button Command="{Binding ImportCommand}"
                        ToolTipService.ToolTip="{Binding ImportButtonLabel}">
                    <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                </Button>

                <Border Width="1"
                        Height="20"
                        Margin="4,6"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Button Style="{StaticResource ExplorerToolbarButtonStyle}"
                        Command="{Binding CutItemCommand}"
                        ToolTipService.ToolTip="Cut (Ctrl+X)">
                    <FontIcon Glyph="&#xE8C6;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ExplorerToolbarButtonStyle}"
                        Command="{Binding CopyItemCommand}"
                        ToolTipService.ToolTip="Copy (Ctrl+C)">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ExplorerToolbarButtonStyle}"
                        Command="{Binding PasteItemCommand}"
                        ToolTipService.ToolTip="Paste (Ctrl+V)">
                    <FontIcon Glyph="&#xE77F;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ExplorerToolbarButtonStyle}"
                        Command="{Binding RenameItemCommand}"
                        ToolTipService.ToolTip="Rename (F2)">
                    <FontIcon Glyph="&#xE8AC;" FontSize="14" />
                </Button>
                <Button Style="{StaticResource ExplorerToolbarButtonStyle}"
                        Command="{Binding DeleteItemCommand}"
                        ToolTipService.ToolTip="Delete (Del)">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>

                <ProgressRing IsActive="{Binding IsBusy}"
                              Width="20"
                              Height="20"
                              Margin="8,0,0,0"
                              Visibility="{Binding BusyVisibility}" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondary}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="{ThemeResource CardStrokeColorDefault}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                Visibility="{Binding ContentVisibility}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="HeaderScrollViewer"
                              Grid.Row="0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              ViewChanged="HeaderScrollViewer_ViewChanged">
                    <Grid MinWidth="720"
                          Height="{StaticResource ExplorerTableHeaderHeight}"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="0,0,0,1"
                          ColumnDefinitions="*,100,100,140">
                        <Border Grid.Column="0" Style="{StaticResource ExplorerColumnSeparatorBorderStyle}">
                            <Button Style="{StaticResource SortHeaderButtonStyle}"
                                    Command="{Binding SortByNameCommand}">
                                <Grid>
                                    <FontIcon Glyph="{Binding NameSortIndicator}"
                                              FontSize="8"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Top"
                                              Margin="0,5,0,0"
                                              Visibility="{Binding NameSortVisibility}" />
                                    <TextBlock Text="Name"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               Margin="12,0,8,6" />
                                </Grid>
                            </Button>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource ExplorerColumnSeparatorBorderStyle}">
                            <Button Style="{StaticResource SortHeaderButtonStyle}"
                                    Command="{Binding SortByTypeCommand}">
                                <Grid>
                                    <FontIcon Glyph="{Binding TypeSortIndicator}"
                                              FontSize="8"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Top"
                                              Margin="0,5,0,0"
                                              Visibility="{Binding TypeSortVisibility}" />
                                    <TextBlock Text="Type"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               Margin="12,0,8,6" />
                                </Grid>
                            </Button>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource ExplorerColumnSeparatorBorderStyle}">
                            <Button Style="{StaticResource SortHeaderButtonStyle}"
                                    Command="{Binding SortBySizeCommand}">
                                <Grid>
                                    <FontIcon Glyph="{Binding SizeSortIndicator}"
                                              FontSize="8"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Top"
                                              Margin="0,5,0,0"
                                              Visibility="{Binding SizeSortVisibility}" />
                                    <TextBlock Text="Size"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               Margin="12,0,8,6" />
                                </Grid>
                            </Button>
                        </Border>

                        <Border Grid.Column="3">
                            <Button Style="{StaticResource SortHeaderButtonStyle}"
                                    Command="{Binding SortByModifiedCommand}">
                                <Grid>
                                    <FontIcon Glyph="{Binding ModifiedSortIndicator}"
                                              FontSize="8"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Top"
                                              Margin="0,5,0,0"
                                              Visibility="{Binding ModifiedSortVisibility}" />
                                    <TextBlock Text="Modified"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Bottom"
                                               Margin="12,0,8,6" />
                                </Grid>
                            </Button>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer x:Name="BodyScrollViewer"
                              Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ViewChanged="BodyScrollViewer_ViewChanged">
                    <ListView x:Name="ExplorerList"
                              MinWidth="720"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              SelectionMode="Single"
                              DoubleTapped="ExplorerList_DoubleTapped"
                              RightTapped="ExplorerList_RightTapped"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="ContextFlyout">
                                    <Setter.Value>
                                        <MenuFlyout Opening="ExplorerContextFlyout_Opening">
                                            <MenuFlyoutItem Text="Rename"
                                                            Click="ExplorerContextRename_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8AC;" />
                                                </MenuFlyoutItem.Icon>
                                                <MenuFlyoutItem.KeyboardAccelerators>
                                                    <KeyboardAccelerator Key="F2" />
                                                </MenuFlyoutItem.KeyboardAccelerators>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Cut"
                                                            Click="ExplorerContextCut_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C6;" />
                                                </MenuFlyoutItem.Icon>
                                                <MenuFlyoutItem.KeyboardAccelerators>
                                                    <KeyboardAccelerator Key="X" Modifiers="Control" />
                                                </MenuFlyoutItem.KeyboardAccelerators>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Copy"
                                                            Click="ExplorerContextCopy_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C8;" />
                                                </MenuFlyoutItem.Icon>
                                                <MenuFlyoutItem.KeyboardAccelerators>
                                                    <KeyboardAccelerator Key="C" Modifiers="Control" />
                                                </MenuFlyoutItem.KeyboardAccelerators>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Paste"
                                                            Click="ExplorerContextPaste_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE77F;" />
                                                </MenuFlyoutItem.Icon>
                                                <MenuFlyoutItem.KeyboardAccelerators>
                                                    <KeyboardAccelerator Key="V" Modifiers="Control" />
                                                </MenuFlyoutItem.KeyboardAccelerators>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Delete"
                                                            Click="ExplorerContextDelete_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                                <MenuFlyoutItem.KeyboardAccelerators>
                                                    <KeyboardAccelerator Key="Delete" />
                                                </MenuFlyoutItem.KeyboardAccelerators>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AttachmentItemViewModel">
                                <Grid MinHeight="36" ColumnDefinitions="*,100,100,140">
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                Margin="12,0,8,0"
                                                VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind IconGlyph}"
                                                  FontSize="14"
                                                  Foreground="{x:Bind TypeLabel, Converter={StaticResource AttachmentTypeBrushConverter}}"
                                                  Opacity="0.9" />
                                        <TextBlock Text="{x:Bind DisplayName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind TypeLabel}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,8,0"
                                               FontSize="12"
                                               Foreground="{x:Bind TypeLabel, Converter={StaticResource AttachmentTypeBrushConverter}}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind SizeDisplay}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,8,0"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondary}" />
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind ModifiedDisplay}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,8,0"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>

                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6"
                            IsHitTestVisible="False"
                            Visibility="{Binding EmptyVisibility}">
                    <FontIcon Glyph="&#xE8B7;" FontSize="24" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding EmptyTitle}"
                               FontSize="12"
                               Opacity="0.7"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
