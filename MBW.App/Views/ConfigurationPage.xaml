<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MBW.App.Views.ConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <StackPanel Padding="32" Spacing="12">
        <TextBlock Text="Configuration" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="Configure matching, attachment rename rules, and sending options." Opacity="0.7" />
        <ListView SelectionMode="None" IsItemClickEnabled="False">
            <ListViewItem Content="Matching" />
            <ListViewItem Content="Rename" />
            <ListViewItem Content="Sending" />
        </ListView>
    </StackPanel>
</Page>