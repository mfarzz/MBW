<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MBW.App.Views.ConfigurationPage"
    x:Name="ConfigurationRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MBW.App.ViewModels"
    xmlns:controls="using:MBW.App.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Configuration" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Match individual attachment files to key values in the database."
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,12" Spacing="10" Visibility="{Binding FormVisibility}">
            <Grid ColumnDefinitions="240,360,Auto,Auto,*" ColumnSpacing="10">
                <controls:SearchableComboBox Grid.Column="0"
                                             ItemsSource="{Binding IndividualFolders}"
                                             SelectedItem="{Binding SelectedIndividualFolder, Mode=TwoWay}"
                                             PlaceholderText="Select individual folder"
                                             SearchPlaceholderText="Search folders..." />

                <controls:SearchableComboBox Grid.Column="1"
                                             ItemsSource="{Binding DatabaseColumns}"
                                             SelectedItem="{Binding SelectedKeyColumn, Mode=TwoWay}"
                                             PlaceholderText="Select key column"
                                             SearchPlaceholderText="Search columns..." />

                <Button Grid.Column="2"
                        Command="{Binding MatchCommand}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="Match" />
                    </StackPanel>
                </Button>

                <ProgressRing Grid.Column="3"
                              IsActive="{Binding IsBusy}"
                              Width="20"
                              Height="20"
                              VerticalAlignment="Center"
                              Visibility="{Binding BusyVisibility}" />

                <ComboBox Grid.Column="4"
                          SelectedIndex="{Binding MatchFilterIndex, Mode=TwoWay}"
                          MinWidth="180"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Right">
                    <ComboBoxItem Content="All" />
                    <ComboBoxItem Content="Matched" />
                    <ComboBoxItem Content="Missing" />
                </ComboBox>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondary}"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding ValidationSummary}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondary}"
                       Visibility="{Binding SummaryVisibility}" />
        </StackPanel>

        <Border Grid.Row="1"
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorSecondary}"
                BorderBrush="{ThemeResource CardStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,16,0,12"
                Visibility="{Binding GateVisibility}">
            <TextBlock Text="{Binding GateMessage}"
                       TextWrapping="Wrap"
                       Opacity="0.85" />
        </Border>

        <Border Grid.Row="2"
                BorderBrush="{ThemeResource CardStrokeColorDefault}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                Visibility="{Binding TableEmptyVisibility}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        MaxWidth="360">
                <FontIcon Glyph="&#xE8E5;" FontSize="28" Opacity="0.45" HorizontalAlignment="Center" />
                <TextBlock Text="No match results yet"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Select an individual folder and key column, then click Match to show the table."
                           Opacity="0.7"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="{ThemeResource CardStrokeColorDefault}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                Visibility="{Binding TableVisibility}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                      BorderThickness="0,0,0,1"
                      Height="{StaticResource ExplorerTableHeaderHeight}"
                      ColumnDefinitions="80,*,*,120">
                    <Border Grid.Column="0" Style="{StaticResource ExplorerColumnSeparatorBorderStyle}">
                        <TextBlock Text="Row"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="12,0,8,0"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ExplorerColumnSeparatorBorderStyle}">
                        <TextBlock Text="{Binding KeyColumnHeader}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="12,0,8,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource ExplorerColumnSeparatorBorderStyle}">
                        <TextBlock Text="File"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="12,0,8,0"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="3"
                               Text="Status"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="12,0,8,0"
                               VerticalAlignment="Center" />
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding MatchRows}"
                          SelectionMode="None"
                          Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="36" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConfigurationLinkPreviewRow">
                            <Grid ColumnDefinitions="80,*,*,120"
                                  MinHeight="36"
                                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                  BorderThickness="0,0,0,1">
                                <Border Grid.Column="0" Style="{StaticResource ExplorerColumnSeparatorBorderStyle}">
                                    <TextBlock Text="{x:Bind RowNumber}"
                                               FontSize="12"
                                               Margin="12,0,8,0"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource ExplorerColumnSeparatorBorderStyle}">
                                    <TextBlock Text="{x:Bind KeyValue}"
                                               FontSize="12"
                                               Margin="12,0,8,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource ExplorerColumnSeparatorBorderStyle}">
                                    <TextBlock Text="{x:Bind FileDisplay}"
                                               FontSize="12"
                                               Margin="12,0,8,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <StackPanel Grid.Column="3"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            Margin="12,0,8,0"
                                            VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="12" />
                                    <TextBlock Text="{x:Bind StatusLabel}" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,12,0,0"
                    Visibility="{Binding PaginationVisibility}">
            <Button Content="Previous"
                    Command="{Binding PreviousPageCommand}"
                    IsEnabled="{Binding CanGoPrevious}" />
            <TextBlock Text="{Binding PageCaption}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondary}" />
            <Button Content="Next"
                    Command="{Binding NextPageCommand}"
                    IsEnabled="{Binding CanGoNext}" />
        </StackPanel>
    </Grid>
</Page>
