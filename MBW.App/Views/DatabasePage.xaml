<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MBW.App.Views.DatabasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="Database" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Import dan preview data penerima dari file Excel (.xlsx / .xlsm)."
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,12" Spacing="10">
            <Border Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondary}"
                    BorderBrush="{ThemeResource CardStrokeColorDefault}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding NoWorkspaceVisibility}">
                <TextBlock Text="Buat atau buka workspace terlebih dahulu sebelum mengimport Excel."
                           TextWrapping="Wrap"
                           Opacity="0.85" />
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding ImportExcelCommand}"
                        IsEnabled="{Binding CanImport}"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        <TextBlock Text="Import file Excel" />
                    </StackPanel>
                </Button>
                <ProgressRing IsActive="{Binding IsBusy}"
                              Width="20"
                              Height="20"
                              Visibility="{Binding BusyVisibility}" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondary}"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding FileSummary}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondary}"
                       Visibility="{Binding PreviewVisibility}" />
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="{ThemeResource CardStrokeColorDefault}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                Visibility="{Binding EmptyVisibility}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        MaxWidth="360">
                <FontIcon Glyph="&#xE8F1;" FontSize="28" Opacity="0.45" HorizontalAlignment="Center" />
                <TextBlock Text="Belum ada database"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Klik Import file Excel, pilih sheet dan baris header, lalu konfirmasi untuk menyimpan data penerima."
                           Opacity="0.7"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="{ThemeResource CardStrokeColorDefault}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                Visibility="{Binding PreviewVisibility}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="HeaderScrollViewer"
                              Grid.Row="0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              ViewChanged="HeaderScrollViewer_ViewChanged">
                    <Border x:Name="HeaderHost"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Height="{StaticResource ExplorerTableHeaderHeight}"
                            MinWidth="400" />
                </ScrollViewer>

                <ScrollViewer x:Name="BodyScrollViewer"
                              Grid.Row="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ViewChanged="BodyScrollViewer_ViewChanged">
                    <StackPanel x:Name="BodyHost" Spacing="0" MinWidth="400" />
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,12,0,0"
                    Visibility="{Binding PreviewVisibility}">
            <Button Content="Sebelumnya"
                    Command="{Binding PreviousPageCommand}"
                    IsEnabled="{Binding CanGoPrevious}" />
            <TextBlock Text="{Binding PageCaption}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondary}" />
            <Button Content="Berikutnya"
                    Command="{Binding NextPageCommand}"
                    IsEnabled="{Binding CanGoNext}" />
        </StackPanel>
    </Grid>
</Page>
