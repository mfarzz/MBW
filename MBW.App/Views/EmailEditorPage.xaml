<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MBW.App.Views.EmailEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MBW.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header with Title and Action Buttons -->
        <Grid Grid.Row="0" Padding="20,16" ColumnDefinitions="*,Auto,Auto" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="Email" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" />
                <TextBlock Text="Compose the message sent to every recipient. Use variables for personalization." FontSize="13" Foreground="{ThemeResource TextFillColorSecondary}" Margin="0,4,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Content="Preview" Style="{StaticResource DefaultButtonStyle}" Margin="0,0,8,0" 
                    Command="{Binding PreviewCommand}" />
            <Button Grid.Column="2" Content="Continue to Sending" Style="{StaticResource AccentButtonStyle}" 
                    Command="{Binding ContinueCommand}" />
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Padding="20" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto,*">
            <!-- Left Column: Editor -->
            <Grid Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" RowDefinitions="Auto,Auto,*">
                <!-- Subject Field -->
                <Grid Grid.Row="0" RowDefinitions="Auto,Auto">
                    <TextBlock Text="Subject" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" />
                    <TextBox Grid.Row="1" Text="{Binding Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,8,0,0" MinHeight="36" Padding="12,8" 
                             PlaceholderText="Enter email subject..." />
                </Grid>

                <!-- Formatting Toolbar -->
                <Grid Grid.Row="1" Margin="0,16,0,0" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefault}" 
                      CornerRadius="4" BorderBrush="{ThemeResource CardStrokeColorDefault}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- Undo/Redo -->
                        <Button ToolTipService.ToolTip="Undo" Background="Transparent" Click="OnUndoClick">
                            <SymbolIcon Symbol="Undo" />
                        </Button>
                        <Button ToolTipService.ToolTip="Redo" Background="Transparent" Click="OnRedoClick">
                            <SymbolIcon Symbol="Redo" />
                        </Button>

                        <AppBarSeparator />

                        <!-- Text Formatting -->
                        <Button ToolTipService.ToolTip="Bold" Background="Transparent" Click="OnBoldClick" x:Name="BoldBtn">
                            <FontIcon Glyph="&#xE19B;" />
                        </Button>
                        <Button ToolTipService.ToolTip="Italic" Background="Transparent" Click="OnItalicClick">
                            <FontIcon Glyph="&#xE19C;" />
                        </Button>
                        <Button ToolTipService.ToolTip="Underline" Background="Transparent" Click="OnUnderlineClick">
                            <FontIcon Glyph="&#xE19D;" />
                        </Button>

                        <AppBarSeparator />

                        <!-- Font Size -->
                        <ComboBox Width="60" SelectedIndex="2" SelectionChanged="OnFontSizeChanged">
                            <ComboBoxItem Content="10" />
                            <ComboBoxItem Content="12" />
                            <ComboBoxItem Content="14" />
                            <ComboBoxItem Content="16" />
                            <ComboBoxItem Content="18" />
                            <ComboBoxItem Content="20" />
                        </ComboBox>

                        <AppBarSeparator />

                        <!-- Alignment -->
                        <Button ToolTipService.ToolTip="Align Left" Background="Transparent" Click="OnAlignLeftClick">
                            <FontIcon Glyph="&#xE8E1;" />
                        </Button>
                        <Button ToolTipService.ToolTip="Align Center" Background="Transparent" Click="OnAlignCenterClick">
                            <FontIcon Glyph="&#xE8E2;" />
                        </Button>
                        <Button ToolTipService.ToolTip="Align Right" Background="Transparent" Click="OnAlignRightClick">
                            <FontIcon Glyph="&#xE8E3;" />
                        </Button>

                        <AppBarSeparator />

                        <!-- Lists -->
                        <Button ToolTipService.ToolTip="Bullet List" Background="Transparent" Click="OnBulletListClick">
                            <FontIcon Glyph="&#xE71C;" />
                        </Button>
                        <Button ToolTipService.ToolTip="Numbered List" Background="Transparent" Click="OnNumberedListClick">
                            <FontIcon Glyph="&#xE71D;" />
                        </Button>

                        <AppBarSeparator />

                        <!-- Link and Insert Variable -->
                        <Button ToolTipService.ToolTip="Insert Link" Background="Transparent" Click="OnLinkClick">
                            <FontIcon Glyph="&#xE71B;" />
                        </Button>

                        <AppBarSeparator />

                        <Button ToolTipService.ToolTip="Insert Variable" Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{}" Foreground="{ThemeResource TextFillColorPrimary}" />
                                <TextBlock Text="Insert Variable" Foreground="{ThemeResource TextFillColorPrimary}" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="VariableFlyout" Opened="VariableFlyout_Opened">
                                    <MenuFlyout.Items>
                                        <MenuFlyoutItem Text="Select variable..." IsEnabled="False" />
                                        <MenuFlyoutSeparator />
                                    </MenuFlyout.Items>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <AppBarSeparator />

                        <!-- Clear -->
                        <Button ToolTipService.ToolTip="Clear" Background="Transparent" Click="OnClearClick">
                            <FontIcon Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- HTML Editor Area (WebView2) -->
                <Border Grid.Row="2" Margin="0,16,0,0" BorderBrush="{ThemeResource CardStrokeColorDefault}" 
                        BorderThickness="1" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorDefault}">
                    <Grid RowDefinitions="*,Auto">
                        <!-- WebView2 will be added here from code-behind -->
                        <WebView2 x:Name="HtmlEditor" Grid.Row="0" />

                        <!-- Info Text -->
                        <TextBlock Grid.Row="1" Padding="12" Text="Variables such as {Nama} are replaced per recipient using the loaded database." 
                                   FontSize="12" Foreground="{ThemeResource TextFillColorTertiary}" 
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Column: Available Variables Panel -->
            <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Padding="12,0,0,0">
                <StackPanel Orientation="Vertical" Spacing="12">
                    <!-- Variables Header -->
                    <TextBlock Text="Available Variables" FontSize="13" FontWeight="SemiBold" 
                               Foreground="{ThemeResource TextFillColorPrimary}" />

                    <!-- Variables List -->
                    <ScrollViewer MaxHeight="400">
                        <ListView ItemsSource="{Binding AvailableVariables}" 
                                  SelectionMode="None"
                                  Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid ColumnDefinitions="*,Auto" Padding="0,6" 
                                          BorderBrush="{ThemeResource DividerStrokeColorDefault}" 
                                          BorderThickness="0,0,0,1">
                                        <TextBlock Grid.Column="0" Text="{Binding}" 
                                                   Foreground="{ThemeResource TextFillColorPrimary}" 
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Insert" 
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="OnInsertVariableFromListClick" 
                                                Tag="{Binding}" 
                                                Padding="8,4" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>

                    <!-- No Variables Message -->
                    <TextBlock Text="No variables. Import Excel file first." 
                               Foreground="{ThemeResource TextFillColorSecondary}" 
                               FontSize="12" FontStyle="Italic"
                               Visibility="{Binding NoVariablesVisibility}" />

                    <!-- Save Button -->
                    <Button Content="Save Template" 
                            Style="{StaticResource DefaultButtonStyle}"
                            Command="{Binding SaveCommand}"
                            Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="2" Padding="20,12" Background="{ThemeResource CardBackgroundFillColorDefault}" 
              BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" />
        </Grid>
    </Grid>
</Page>
