<?xml version="1.0" encoding="utf-8"?>

<Page

    x:Class="MBW.App.Views.WelcomePage"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    mc:Ignorable="d"

    Background="{StaticResource MBWStatusBarBrush}">



    <Page.Resources>

        <Style x:Key="RecentProjectButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#14FFFFFF" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="CornerRadius" Value="8" />

            <Setter Property="Padding" Value="12,10" />

            <Setter Property="Margin" Value="0,0,0,8" />

            <Setter Property="HorizontalAlignment" Value="Stretch" />

            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <Setter Property="VerticalContentAlignment" Value="Center" />

        </Style>

    </Page.Resources>



    <Grid Padding="48,32">

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="36" MaxWidth="720" Width="560">

            <StackPanel Spacing="8" HorizontalAlignment="Center">

                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">

                    <Border Width="40" Height="40" CornerRadius="6" Background="#33FFFFFF">

                        <TextBlock Text="M" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    </Border>

                    <TextBlock Text="MBW" FontSize="32" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />

                </StackPanel>

                <TextBlock Text="MailBlast Workspace" FontSize="15" Foreground="#E6FFFFFF" HorizontalAlignment="Center" />

            </StackPanel>



            <Grid ColumnSpacing="20" HorizontalAlignment="Center">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>



                <Button Grid.Column="0" Command="{Binding NewProjectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="#1FFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="8" Padding="0" MinHeight="120">

                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">

                        <Border Width="44" Height="44" CornerRadius="22" Background="#33FFFFFF" HorizontalAlignment="Center">

                            <FontIcon Glyph="&#xE710;" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <TextBlock Text="New Project" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />

                        <TextBlock Text="Create a new workspace" FontSize="12" Foreground="#CCFFFFFF" HorizontalAlignment="Center" TextAlignment="Center" />

                    </StackPanel>

                </Button>



                <Button Grid.Column="1" Command="{Binding OpenProjectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="#1FFFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="8" Padding="0" MinHeight="120">

                    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">

                        <Border Width="44" Height="44" CornerRadius="22" Background="#33FFFFFF" HorizontalAlignment="Center">

                            <FontIcon Glyph="&#xE838;" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <TextBlock Text="Open Project" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />

                        <TextBlock Text="Open an existing workspace" FontSize="12" Foreground="#CCFFFFFF" HorizontalAlignment="Center" TextAlignment="Center" />

                    </StackPanel>

                </Button>

            </Grid>



            <StackPanel Spacing="12" HorizontalAlignment="Center" Width="560">

                <TextBlock Text="Recent Projects" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />



                <TextBlock Text="No recent projects yet."

                           Foreground="#B3FFFFFF"

                           FontSize="13"

                           HorizontalAlignment="Center"

                           Visibility="{Binding EmptyRecentVisibility}" />



                <ItemsControl ItemsSource="{Binding RecentProjects}"

                              Visibility="{Binding RecentListVisibility}"

                              HorizontalAlignment="Stretch">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button Style="{StaticResource RecentProjectButtonStyle}"

                                    Click="RecentProjectButton_Click"

                                    Tag="{Binding}">

                                <Button.Resources>

                                    <SolidColorBrush x:Key="ButtonBackground" Color="#14FFFFFF" />

                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#29FFFFFF" />

                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3DFFFFFF" />

                                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#00FFFFFF" />

                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#00FFFFFF" />

                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#00FFFFFF" />

                                </Button.Resources>

                                <Grid ColumnSpacing="12">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="Auto" />

                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="16" Foreground="White" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="White" />

                                        <TextBlock Text="{Binding LocationDisplay}" FontSize="12" Foreground="#B3FFFFFF" TextTrimming="CharacterEllipsis" />

                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding OpenedDisplay}" FontSize="11" Foreground="#99FFFFFF" VerticalAlignment="Center" />

                                </Grid>

                            </Button>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </StackPanel>

    </Grid>

</Page>


