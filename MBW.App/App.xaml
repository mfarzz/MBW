<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="MBW.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MBW.App"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/ExplorerTableStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- MBW shell palette — matches reference mockup -->
            <Color x:Key="MBWAccentColor">#FF0067C0</Color>
            <Color x:Key="MBWAccentLightColor">#FFE5F0FB</Color>
            <Color x:Key="MBWBackgroundColor">#FFF3F3F3</Color>
            <Color x:Key="MBWSurfaceColor">#FFFFFFFF</Color>
            <Color x:Key="MBWSidebarColor">#FFECECEC</Color>
            <Color x:Key="MBWWorkspaceChipColor">#FFE0E0E0</Color>
            <Color x:Key="MBWStatusBarColor">#FF0067C0</Color>
            <Color x:Key="MBWTextPrimaryColor">#FF1B1B1B</Color>
            <Color x:Key="MBWTextSecondaryColor">#FF616161</Color>
            <Color x:Key="MBWTextTertiaryColor">#FF8A8A8A</Color>
            <Color x:Key="MBWBorderColor">#FFE0E0E0</Color>
            <Color x:Key="MBWGoodColor">#FF0F7B0F</Color>

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource MBWSurfaceColor}" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource MBWBackgroundColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefault" Color="{StaticResource MBWSurfaceColor}" />
            <SolidColorBrush x:Key="MBWSidebarBrush" Color="{StaticResource MBWSidebarColor}" />
            <SolidColorBrush x:Key="MBWWorkspaceChipBrush" Color="{StaticResource MBWWorkspaceChipColor}" />
            <SolidColorBrush x:Key="MBWStatusBarBrush" Color="{StaticResource MBWStatusBarColor}" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource MBWAccentColor}" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource MBWAccentLightColor}" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource MBWWorkspaceChipColor}" />
            <SolidColorBrush x:Key="TextFillColorPrimary" Color="{StaticResource MBWTextPrimaryColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondary" Color="{StaticResource MBWTextSecondaryColor}" />
            <SolidColorBrush x:Key="TextFillColorTertiary" Color="{StaticResource MBWTextTertiaryColor}" />
            <SolidColorBrush x:Key="DividerStrokeColorDefault" Color="{StaticResource MBWBorderColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefault" Color="{StaticResource MBWBorderColor}" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimary" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SystemFillColorSuccess" Color="{StaticResource MBWGoodColor}" />

            <!-- WinUI built-in button/dialog accent uses SystemAccentColor, not AccentFillColorDefaultBrush -->
            <Color x:Key="SystemAccentColor">#FF0067C0</Color>
            <Color x:Key="SystemAccentColorLight1">#FF1A75C9</Color>
            <Color x:Key="SystemAccentColorLight2">#FF4D94D6</Color>
            <Color x:Key="SystemAccentColorLight3">#FF80B3E3</Color>
            <Color x:Key="SystemAccentColorDark1">#FF005CAD</Color>
            <Color x:Key="SystemAccentColorDark2">#FF004682</Color>
            <Color x:Key="SystemAccentColorDark3">#FF003158</Color>

            <!-- Shell layout constants -->
            <GridLength x:Key="ShellTitleBarHeight">36</GridLength>
            <GridLength x:Key="ShellStatusBarHeight">24</GridLength>
            <GridLength x:Key="ShellSidebarWidth">248</GridLength>
            <x:Double x:Key="ShellNavIconSize">16</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
