<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MBW.App.Controls.SmtpSettingsForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="460"
    HorizontalAlignment="Left"
    Background="Transparent">

    <ScrollViewer x:Name="FormScroller"
                  Background="Transparent"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  MaxHeight="520">
        <StackPanel Spacing="12" Padding="0,0,4,0">
            <StackPanel Spacing="8">
                <TextBlock Text="User information"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}" />

                <TextBlock Text="Your name"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}" />
                <TextBox Text="{Binding FromName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Your display name" />

                <TextBlock Text="Email address"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}" />
                <TextBox Text="{Binding FromEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="name@domain.com" />

                <CheckBox Content="Send replies to a different email address"
                          IsChecked="{Binding UseReplyToAddress, Mode=TwoWay}" />

                <TextBlock Text="Reply-to address"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}" />
                <TextBox Text="{Binding ReplyToEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding UseReplyToAddress}"
                         PlaceholderText="reply@domain.com" />
            </StackPanel>

            <Grid x:Name="ServerSectionSeparator"
                  Height="20"
                  Tapped="ServerSectionSeparator_Tapped"
                  PointerEntered="ServerSectionSeparator_PointerEntered"
                  PointerExited="ServerSectionSeparator_PointerExited"
                  ToolTipService.ToolTip="Show SMTP server settings">
                <Rectangle Height="1"
                           VerticalAlignment="Center"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="10,0">
                    <FontIcon Glyph="{Binding ServerSectionChevronGlyph}"
                              FontSize="10"
                              Foreground="{ThemeResource TextFillColorSecondary}" />
                </Border>
            </Grid>

            <StackPanel Spacing="8"
                        Visibility="{Binding ServerSectionVisibility}">
                <TextBlock Text="Outgoing mail server (SMTP)"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}" />

                <TextBlock Text="Server name"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}" />
                <TextBox Text="{Binding Server, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="smtp.office365.com" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="Port"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimary}" />
                        <TextBox Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="587"
                                 InputScope="Number" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4" MinWidth="160">
                        <TextBlock Text="Security"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimary}" />
                        <ComboBox ItemsSource="{Binding SecurityOptions}"
                                  SelectedIndex="{Binding SelectedSecurityIndex, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>

                <CheckBox Content="Use secure connection (TLS/SSL)"
                          IsChecked="{Binding UseSecureConnection, Mode=TwoWay}" />

                <TextBlock Text="Server authentication"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}"
                           Margin="0,4,0,0" />
                <CheckBox Content="Outgoing server requires authentication"
                          IsChecked="{Binding RequiresAuthentication, Mode=TwoWay}" />

                <TextBlock Text="Username"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}" />
                <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding RequiresAuthentication}"
                         PlaceholderText="user@example.com" />

                <TextBlock Text="Password"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimary}" />
                <PasswordBox x:Name="PasswordBox"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             IsEnabled="{Binding RequiresAuthentication}"
                             PlaceholderText="Password" />

                <Button Content="Test settings"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding TestConnectionCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0" />

                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondary}"
                           TextWrapping="WrapWholeWords"
                           MinHeight="20" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
