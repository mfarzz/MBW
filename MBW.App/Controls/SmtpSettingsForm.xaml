<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MBW.App.Controls.SmtpSettingsForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Width="420">

    <StackPanel Spacing="12">
        <TextBlock Text="SMTP Server" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" />
        <TextBox Text="{Binding Server, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="smtp.example.com" />

        <TextBlock Text="Port" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" />
        <TextBox Text="{Binding PortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="587" InputScope="Number" />

        <TextBlock Text="Security" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" />
        <ComboBox ItemsSource="{Binding SecurityOptions}" SelectedIndex="{Binding SelectedSecurityIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />

        <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" />
        <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="user@example.com" />

        <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" />
        <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" PlaceholderText="Password" />

        <Button Content="Test Connection" Style="{StaticResource AccentButtonStyle}" Command="{Binding TestConnectionCommand}" HorizontalAlignment="Left" />

        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" TextWrapping="WrapWholeWords" MinHeight="20" />
    </StackPanel>
</UserControl>
