<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MBW.App.Controls.SearchableComboBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch">

    <Grid>
        <Button x:Name="TriggerButton"
                Click="TriggerButton_Click"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="12,8"
                Background="{ThemeResource ComboBoxBackground}"
                BorderBrush="{ThemeResource ComboBoxBorderBrush}"
                BorderThickness="1">
            <FlyoutBase.AttachedFlyout>
                <Flyout x:Name="OptionsFlyout"
                        Opening="OptionsFlyout_Opening"
                        Placement="Bottom"
                        ShouldConstrainToRootBounds="False">
                    <StackPanel x:Name="FlyoutContentPanel" Spacing="8">
                        <TextBox x:Name="SearchBox"
                                 HorizontalAlignment="Stretch"
                                 PlaceholderText="Search..."
                                 TextChanged="SearchBox_TextChanged" />
                        <ListView x:Name="ItemsList"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="ItemsList_ItemClick"
                                  MaxHeight="280">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{Binding}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Flyout>
            </FlyoutBase.AttachedFlyout>
            <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                <TextBlock x:Name="SelectedTextBlock"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <FontIcon Grid.Column="1"
                          Glyph="&#xE70D;"
                          FontSize="12"
                          Opacity="0.7" />
            </Grid>
        </Button>
    </Grid>
</UserControl>
