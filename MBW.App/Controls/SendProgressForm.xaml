<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MBW.App.Controls.SendProgressForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:MBW.App.Converters"
    xmlns:vm="using:MBW.App.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel Spacing="12" MinWidth="400">
        <StackPanel Spacing="6">
            <TextBlock Text="{Binding ProgressCaption}"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondary}" />
            <ProgressBar Value="{Binding ProgressValue}"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Maximum="100"
                         Height="6" />
        </StackPanel>

        <Border BorderBrush="{ThemeResource CardStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorDefault}"
                MinHeight="200"
                MaxHeight="280">
            <ListView x:Name="LogList"
                      ItemsSource="{Binding Entries}"
                      SelectionMode="None"
                      Padding="8,8,20,8">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SendProgressEntry">
                        <Grid ColumnSpacing="8"
                              Padding="0,4"
                              MinHeight="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind RowLabel}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondary}"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Email}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       ToolTipService.ToolTip="{x:Bind Email}" />

                            <FontIcon Grid.Column="2"
                                      Glyph="&#xE73E;"
                                      FontSize="14"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                      Visibility="{x:Bind IsSucceeded, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center" />

                            <ProgressRing Grid.Column="2"
                                          Width="16"
                                          Height="16"
                                          IsActive="{x:Bind IsSending, Mode=OneWay}"
                                          Visibility="{x:Bind IsSending, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />

                            <FontIcon Grid.Column="2"
                                      Glyph="&#xE711;"
                                      FontSize="12"
                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                      Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      ToolTipService.ToolTip="{x:Bind ErrorMessage, Mode=OneWay}" />

                            <TextBlock Grid.Column="2"
                                       Text="—"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind IsSkipped, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       ToolTipService.ToolTip="{x:Bind ErrorMessage, Mode=OneWay}" />

                            <TextBlock Grid.Column="2"
                                       Text="—"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind IsCancelled, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </StackPanel>
</UserControl>
