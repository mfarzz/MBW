<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MBW.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="MBW">

    <Grid x:Name="RootLayoutGrid" Background="{StaticResource MBWSidebarBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="FileNewWorkspace_Invoked" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="FileOpenWorkspace_Invoked" />
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="FileSaveWorkspace_Invoked" />
            <KeyboardAccelerator Key="F4" Modifiers="Menu" Invoked="FileExit_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource ShellTitleBarHeight}" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="StatusBarRow" Height="{StaticResource ShellStatusBarHeight}" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,10,0">
                <Border Width="20" Height="20" CornerRadius="3" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="M" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="MBW" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                <Button x:Name="FileMenuButton" Content="File" Style="{StaticResource SubtleButtonStyle}" Height="28" Padding="10,0">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="New Workspace" Click="FileNewWorkspace_Click" KeyboardAcceleratorTextOverride="Ctrl+N" />
                            <MenuFlyoutItem Text="Open Workspace" Click="FileOpenWorkspace_Click" KeyboardAcceleratorTextOverride="Ctrl+O" />
                            <MenuFlyoutItem Text="Save Workspace" Click="FileSaveWorkspace_Click" KeyboardAcceleratorTextOverride="Ctrl+S" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Exit" Click="FileExit_Click" KeyboardAcceleratorTextOverride="Alt+F4" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="EditMenuButton" Content="Edit" Style="{StaticResource SubtleButtonStyle}" Height="28" Padding="10,0" Click="TopMenuButton_Click" />
                <Button x:Name="ViewMenuButton" Content="View" Style="{StaticResource SubtleButtonStyle}" Height="28" Padding="10,0" Click="TopMenuButton_Click" />
                <Button x:Name="WorkspaceMenuButton" Content="Workspace" Style="{StaticResource SubtleButtonStyle}" Height="28" Padding="10,0">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Database" Click="WorkspaceDatabase_Click" />
                            <MenuFlyoutItem Text="Attachments" Click="WorkspaceAttachments_Click" />
                            <MenuFlyoutItem Text="Configuration" Click="WorkspaceConfiguration_Click" />
                            <MenuFlyoutItem Text="Send" Click="WorkspaceSend_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="SMTP" Click="WorkspaceSmtp_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="HelpMenuButton" Content="Help" Style="{StaticResource SubtleButtonStyle}" Height="28" Padding="10,0" Click="TopMenuButton_Click" />
            </StackPanel>

            <Button Grid.Column="3" x:Name="SmtpButton" Style="{StaticResource SubtleButtonStyle}" Padding="10,0" Margin="0,0,4,0" Click="SmtpButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse x:Name="SmtpDot" Width="7" Height="7" Fill="{ThemeResource SystemFillColorSuccess}" />
                    <TextBlock x:Name="SmtpStatusText" Text="SMTP: Connected" FontSize="12" Foreground="{ThemeResource TextFillColorSecondary}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Body -->
        <Grid x:Name="ShellBodyGrid" Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="{StaticResource ShellSidebarWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid x:Name="ShellSidebarPanel" Grid.Column="0" Background="{StaticResource MBWSidebarBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefault}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="WORKSPACE" Margin="12,12,12,6" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondary}" />

                <Border Grid.Row="1" Margin="12,0,12,8" Height="28" Background="{StaticResource MBWWorkspaceChipBrush}" CornerRadius="4" Padding="8,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16">
                            <SymbolIcon Symbol="Folder" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Viewbox>
                        <TextBlock x:Name="WorkspaceNameText" Text="Seminar-FTI" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimary}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,8" Spacing="1">
                        <!-- Email -->
                        <Button x:Name="EmailNavButton" Tag="Email" Click="NavButton_Click" Style="{StaticResource SubtleButtonStyle}" Height="32" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="0" CornerRadius="0">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="EmailNavRail" Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <Viewbox Width="{StaticResource ShellNavIconSize}" Height="{StaticResource ShellNavIconSize}">
                                        <SymbolIcon x:Name="EmailNavIcon" Symbol="Mail" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    </Viewbox>
                                    <TextBlock Text="Email" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimary}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Database -->
                        <Button x:Name="DatabaseNavButton" Tag="Database" Click="NavButton_Click" Style="{StaticResource SubtleButtonStyle}" Height="32" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="0" CornerRadius="0">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="DatabaseNavRail" Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                <Grid Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="{StaticResource ShellNavIconSize}" Height="{StaticResource ShellNavIconSize}">
                                        <FontIcon x:Name="DatabaseNavIcon" Glyph="&#xE8F1;" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Database" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimary}" />
                                </Grid>
                            </Grid>
                        </Button>

                        <!-- Attachments -->
                        <Button x:Name="AttachmentsNavButton" Tag="Attachments" Click="NavButton_Click" Style="{StaticResource SubtleButtonStyle}" Height="32" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="0" CornerRadius="0">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AttachmentsNavRail" Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                <Grid Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="{StaticResource ShellNavIconSize}" Height="{StaticResource ShellNavIconSize}">
                                        <SymbolIcon x:Name="AttachmentsNavIcon" Symbol="Attach" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Attachments" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimary}" />
                                </Grid>
                            </Grid>
                        </Button>

                        <!-- Configuration -->
                        <Button x:Name="ConfigurationNavButton" Tag="Configuration" Click="NavButton_Click" Style="{StaticResource SubtleButtonStyle}" Height="32" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="0" CornerRadius="0">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ConfigurationNavRail" Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                <Grid Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Grid.Column="0" Width="{StaticResource ShellNavIconSize}" Height="{StaticResource ShellNavIconSize}">
                                        <SymbolIcon x:Name="ConfigurationNavIcon" Symbol="Setting" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="Configuration" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimary}" />
                                </Grid>
                            </Grid>
                        </Button>

                        <!-- Send -->
                        <Button x:Name="SendNavButton" Tag="Send" Click="NavButton_Click" Style="{StaticResource SubtleButtonStyle}" Height="32" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="0" CornerRadius="0">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="SendNavRail" Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="12,0,10,0" VerticalAlignment="Center">
                                    <Viewbox Width="{StaticResource ShellNavIconSize}" Height="{StaticResource ShellNavIconSize}">
                                        <SymbolIcon x:Name="SendNavIcon" Symbol="Send" Foreground="{ThemeResource TextFillColorSecondary}" />
                                    </Viewbox>
                                    <TextBlock Text="Send" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimary}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Frame x:Name="RootFrame" Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
        </Grid>

        <!-- Status bar -->
        <Grid x:Name="ShellStatusBar" Grid.Row="2" Background="{StaticResource MBWStatusBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{ThemeResource SystemFillColorSuccess}" VerticalAlignment="Center" />
                <TextBlock Text="SMTP: Connected" Foreground="White" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="DatabaseStatusText" Grid.Column="1" Text="Database: —" Foreground="White" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="AttachmentStatusText" Grid.Column="2" Text="Attachments: —" Foreground="White" FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusWorkspaceText" Grid.Column="4" Text="Seminar-FTI" Foreground="White" FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="5" Text="UTF-8" Foreground="White" FontSize="11" Margin="0,0,16,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="WorkspaceSavedText" Text="Ready" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                <FontIcon Glyph="&#xE897;" Foreground="White" FontSize="11" Opacity="0.85" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
